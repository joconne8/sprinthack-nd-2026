    "metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "enum": [
            "net_sales",
            "labor_hours",
            "revenue_per_labor_hour",
            "contribution_margin",
            "contribution",
            "fees",
            "shipping_expense",
            "labor_cost"
          ]
