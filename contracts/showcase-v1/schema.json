        "definition": {
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "value",
        "unit",
        "availability",
        "availability_reason",
        "definition"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
