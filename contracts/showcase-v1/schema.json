    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "showcase-v1"
        },
        "synthetic": {
          "const": true
        },
        "snapshot_id": {
          "type": "string"
        },
        "published_at": {
          "type": "string"
        },
        "definition_version": {
          "type": "string"
        },
        "month": {
          "const": "2026-09"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "upright_replica",
                  "cash_monkey_replica"
                ]
              },
              "metric_run_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
