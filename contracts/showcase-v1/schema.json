              "input_id": {
                "type": "string"
              },
              "source_row_number": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "source",
              "record_key",
              "amount",
              "input_id",
              "source_row_number"
            ]
          }
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "contract_version",
        "synthetic",
        "snapshot_id",
        "labor",
        "shipping",
        "definitions"
      ]
