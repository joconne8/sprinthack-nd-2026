        "end_date": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "enum": [
            "all",
            "upright_replica",
            "cash_monkey_replica"
          ]
        },
        "store": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "start_date",
        "end_date",
        "source",
        "store",
        "platform"
      ]
