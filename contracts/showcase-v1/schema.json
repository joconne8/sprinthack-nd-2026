      "required": [
        "contract_version",
        "synthetic",
        "snapshot_id",
        "scope",
        "total_rows",
        "rows",
        "scope_total"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
