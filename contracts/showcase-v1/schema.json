      "required": [
        "contract_version",
        "synthetic",
        "snapshot_id",
        "previous",
        "current",
        "explanation",
        "verified_cause"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "upright_replica",
