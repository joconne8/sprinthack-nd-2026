        "expected_days": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "covered_days": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "missing_days": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "required": [
        "state",
        "expected_days",
        "covered_days",
        "missing_days"
      ]
