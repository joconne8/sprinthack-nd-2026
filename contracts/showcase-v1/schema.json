              },
              "coverage": {
                "$ref": "#/$defs/coverage"
              },
              "latest_import_state": {
                "type": "string"
              },
              "latest_batch_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
