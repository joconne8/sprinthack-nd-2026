        "skill_version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "source_name": {
          "type": "string",
          "enum": [
            "upright_replica",
            "cash_monkey_replica"
          ]
        },
        "report_type": {
          "enum": [
            "paid_orders",
            "orders"
          ]
        },
        "target": {
          "type": "string"
        },
        "allowed_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "timeouts_ms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 0
