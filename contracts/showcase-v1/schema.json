        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+\\.\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "enum": [
            "USD",
            "hours",
            "USD/hour",
            "percent"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "availability_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
