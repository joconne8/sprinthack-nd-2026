    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "showcase-v1"
        },
        "synthetic": {
          "const": true
        },
        "snapshot_id": {
          "type": "string"
        },
        "intent": {
          "enum": [
            "sales",
            "evidence",
            "productivity",
            "missing",
            "unsupported"
          ]
        },
        "answer": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "enum": [
              "metrics",
              "comparison",
              "evidence"
            ]
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
