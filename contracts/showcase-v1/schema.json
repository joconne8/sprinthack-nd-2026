    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "goto",
            "assert",
            "click",
            "fill",
            "select",
            "wait_state",
            "download"
          ]
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "within": {
          "type": "object",
