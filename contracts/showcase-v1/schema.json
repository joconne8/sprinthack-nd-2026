            "total": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "step",
            "total"
          ]
        },
        "stop_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "string"
        }
