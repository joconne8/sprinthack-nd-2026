              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "url"
            ]
          }
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        }
      },
      "required": [
        "contract_version",
        "synthetic",
        "snapshot_id",
        "intent",
        "answer",
        "tools",
        "citations"
      ]
    },
