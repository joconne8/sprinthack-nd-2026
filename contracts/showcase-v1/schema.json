    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "navigate",
            "click",
            "fill",
            "select",
            "ready",
            "download"
          ]
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "observation": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "path",
