                  "upright_replica",
                  "cash_monkey_replica"
                ]
              },
              "net_sales": {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$"
              },
              "records": {
                "type": "integer",
                "minimum": 0
              },
              "orders": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "source",
              "net_sales",
              "records",
              "orders"
            ]
          }
        },
        "by_platform": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "platform": {
                "type": "string"
              },
              "net_sales": {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$"
              }
            },
            "required": [
              "platform",
              "net_sales"
            ]
          }
        },
        "by_store": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "store": {
                "type": "string"
              },
              "net_sales": {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$"
              }
            },
            "required": [
              "store",
              "net_sales"
            ]
          }
        },
        "customer_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "upright_replica",
                  "cash_monkey_replica"
                ]
              },
              "platform": {
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "availability": {
                "enum": [
                  "available",
                  "partial",
                  "unavailable"
                ]
              }
            },
            "required": [
              "source",
              "platform",
              "value",
              "availability"
            ]
          }
        },
        "evidence_url": {
          "type": "string"
        },
        "auxiliary_url": {
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "synthetic",
        "snapshot_id",
        "scope",
        "coverage",
        "freshness",
        "metrics",
        "daily",
        "by_source",
        "by_platform",
        "by_store",
        "customer_counts",
        "evidence_url",
        "auxiliary_url"
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
