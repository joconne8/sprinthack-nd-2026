{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goodwill v1 inventory",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "goodwill-v1"
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "start_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "snapshot_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "store": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "metric_version": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "partial",
              "unavailable"
            ]
          },
          "availability_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "metric_id",
          "metric_version",
          "value",
          "unit",
          "availability",
          "availability_reason",
          "definition"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "properties": {
              "availability": {
                "const": "unavailable"
              },
              "value": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "availability": {
                "type": "string",
                "enum": [
                  "available",
                  "partial"
                ]
              },
              "metric_id": {
                "const": "M-DEMO-NET-SALES"
              },
              "unit": {
                "const": "USD"
              },
              "value": {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$"
              }
            }
          },
          {
            "properties": {
              "availability": {
                "type": "string",
                "enum": [
                  "available",
                  "partial"
                ]
              },
              "metric_id": {
                "type": "string",
                "enum": [
                  "M-PLATFORM-CUSTOMERS",
                  "M-LISTINGS-CREATED",
                  "M-UNLISTED-BACKLOG"
                ]
              },
              "value": {
                "type": "string",
                "pattern": "^\\d+$"
              }
            }
          }
        ]
      }
    },
    "input_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage_state": {
      "type": "string",
      "enum": [
        "complete",
        "unavailable",
        "partial"
      ]
    }
  },
  "required": [
    "contract_version",
    "synthetic",
    "start_date",
    "end_date",
    "snapshot_at",
    "store",
    "metrics",
    "input_ids",
    "coverage_state"
  ],
  "additionalProperties": false
}
