{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goodwill v1 error",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "goodwill-v1"
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "synthetic",
    "error"
  ],
  "additionalProperties": false
}
