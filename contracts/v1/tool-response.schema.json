{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goodwill v1 tool-response",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "goodwill-v1"
        },
        "synthetic": {
          "type": "boolean",
          "const": true
        },
        "filters_applied": {
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "format": "date"
            },
            "end_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "format": "date"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "store": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "reporting_timezone": {
              "const": "America/New_York"
            }
          },
          "required": [
            "start_date",
            "end_date",
            "source",
            "platform",
            "store",
            "reporting_timezone"
          ],
          "additionalProperties": false
        },
        "metric_run_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric_id": {
                "type": "string",
                "minLength": 1
              },
              "metric_version": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "availability": {
                "type": "string",
                "enum": [
                  "available",
                  "partial",
                  "unavailable"
                ]
              },
              "availability_reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "definition": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "metric_id",
              "metric_version",
              "value",
              "unit",
              "availability",
              "availability_reason",
              "definition"
            ],
            "additionalProperties": false,
            "anyOf": [
              {
                "properties": {
                  "availability": {
                    "const": "unavailable"
                  },
                  "value": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "availability": {
                    "type": "string",
                    "enum": [
                      "available",
                      "partial"
                    ]
                  },
                  "metric_id": {
                    "const": "M-DEMO-NET-SALES"
                  },
                  "unit": {
                    "const": "USD"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^-?\\d+\\.\\d{2}$"
                  }
                }
              },
              {
                "properties": {
                  "availability": {
                    "type": "string",
                    "enum": [
                      "available",
                      "partial"
                    ]
                  },
                  "metric_id": {
                    "type": "string",
                    "enum": [
                      "M-PLATFORM-CUSTOMERS",
                      "M-LISTINGS-CREATED",
                      "M-UNLISTED-BACKLOG"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^\\d+$"
                  }
                }
              }
            ]
          }
        },
        "coverage": {
          "type": "object",
          "properties": {
            "expected_days": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "format": "date"
              }
            },
            "complete_days": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "format": "date"
              }
            },
            "missing_or_partial_days": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "format": "date"
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            }
          },
          "required": [
            "expected_days",
            "complete_days",
            "missing_or_partial_days",
            "state"
          ],
          "additionalProperties": false
        },
        "freshness": {
          "type": "object",
          "properties": {
            "published_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "latest_import_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "is_last_good": {
              "type": "boolean"
            },
            "publication_state": {
              "type": "string",
              "enum": [
                "published",
                "stale_last_good",
                "unpublished"
              ]
            },
            "warning": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "published_at",
            "latest_import_at",
            "is_last_good",
            "publication_state",
            "warning"
          ],
          "additionalProperties": false
        },
        "reconciliation_state": {
          "type": "string",
          "enum": [
            "verified",
            "unpublished"
          ]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "row_count": {
              "type": "integer",
              "minimum": 0
            },
            "gross_item_sales": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?\\d+\\.\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "refunds": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?\\d+\\.\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "missing_store_rows": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "row_count",
            "gross_item_sales",
            "refunds",
            "missing_store_rows"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "synthetic",
        "filters_applied",
        "metric_run_id",
        "metrics",
        "coverage",
        "freshness",
        "reconciliation_state",
        "evidence"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "goodwill-v1"
        },
        "synthetic": {
          "type": "boolean",
          "const": true
        },
        "metric_run_id": {
          "type": "string",
          "minLength": 1
        },
        "filters_applied": {
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "format": "date"
            },
            "end_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "format": "date"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "store": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "reporting_timezone": {
              "const": "America/New_York"
            }
          },
          "required": [
            "start_date",
            "end_date",
            "source",
            "platform",
            "store",
            "reporting_timezone"
          ],
          "additionalProperties": false
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "total_rows": {
          "type": "integer",
          "minimum": 0
        },
        "scope_total": {
          "type": "string",
          "pattern": "^-?\\d+\\.\\d{2}$"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version_id": {
                "type": "string",
                "minLength": 1
              },
              "record_key": {
                "type": "string",
                "minLength": 1
              },
              "file_id": {
                "type": "string",
                "minLength": 1
              },
              "batch_id": {
                "type": "string",
                "minLength": 1
              },
              "source_row_number": {
                "type": "integer",
                "minimum": 0
              },
              "parser_version": {
                "type": "string",
                "minLength": 1
              },
              "rule_version": {
                "type": "string",
                "minLength": 1
              },
              "reporting_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "format": "date"
              },
              "source_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "format": "date"
              },
              "source_timestamp": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "platform": {
                "type": "string",
                "minLength": 1
              },
              "store_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "buyer_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "gross_item_sales": {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$"
              },
              "refunds": {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$"
              },
              "demo_net_sales": {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$"
              },
              "currency": {
                "const": "USD"
              },
              "synthetic": {
                "type": "boolean",
                "const": true
              },
              "original_row": {
                "type": "object"
              }
            },
            "required": [
              "version_id",
              "record_key",
              "file_id",
              "batch_id",
              "source_row_number",
              "parser_version",
              "rule_version",
              "reporting_date",
              "source_date",
              "source_timestamp",
              "platform",
              "store_id",
              "buyer_id",
              "gross_item_sales",
              "refunds",
              "demo_net_sales",
              "currency",
              "synthetic",
              "original_row"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contract_version",
        "synthetic",
        "metric_run_id",
        "filters_applied",
        "offset",
        "limit",
        "total_rows",
        "scope_total",
        "rows"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "goodwill-v1"
        },
        "synthetic": {
          "type": "boolean",
          "const": true
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "detail"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "synthetic",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
