{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goodwill v1 acquisition-request",
  "type": "object",
  "properties": {
    "start_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "mode": {
      "type": "string",
      "enum": [
        "normal",
        "delayed",
        "session-expired",
        "missing-report",
        "changed-label",
        "timeout"
      ]
    }
  },
  "required": [
    "start_date",
    "end_date"
  ],
  "additionalProperties": false
}
