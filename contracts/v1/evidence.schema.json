{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goodwill v1 evidence",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "goodwill-v1"
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "metric_run_id": {
      "type": "string",
      "minLength": 1
    },
    "filters_applied": {
      "type": "object",
      "properties": {
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "store": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reporting_timezone": {
          "const": "America/New_York"
        }
      },
      "required": [
        "start_date",
        "end_date",
        "source",
        "platform",
        "store",
        "reporting_timezone"
      ],
      "additionalProperties": false
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "total_rows": {
      "type": "integer",
      "minimum": 0
    },
    "scope_total": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version_id": {
            "type": "string",
            "minLength": 1
          },
          "record_key": {
            "type": "string",
            "minLength": 1
          },
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "batch_id": {
            "type": "string",
            "minLength": 1
          },
          "source_row_number": {
            "type": "integer",
            "minimum": 0
          },
          "parser_version": {
            "type": "string",
            "minLength": 1
          },
          "rule_version": {
            "type": "string",
            "minLength": 1
          },
          "reporting_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date"
          },
          "source_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date"
          },
          "source_timestamp": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "store_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "buyer_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "gross_item_sales": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "refunds": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "demo_net_sales": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "currency": {
            "const": "USD"
          },
          "synthetic": {
            "type": "boolean",
            "const": true
          },
          "original_row": {
            "type": "object"
          }
        },
        "required": [
          "version_id",
          "record_key",
          "file_id",
          "batch_id",
          "source_row_number",
          "parser_version",
          "rule_version",
          "reporting_date",
          "source_date",
          "source_timestamp",
          "platform",
          "store_id",
          "buyer_id",
          "gross_item_sales",
          "refunds",
          "demo_net_sales",
          "currency",
          "synthetic",
          "original_row"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "synthetic",
    "metric_run_id",
    "filters_applied",
    "offset",
    "limit",
    "total_rows",
    "scope_total",
    "rows"
  ],
  "additionalProperties": false
}
