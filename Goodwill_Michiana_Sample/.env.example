# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# LLM via LiteLLM-compatible proxy
LITELLM_PROXY_API_BASE=http://localhost:4000
LITELLM_PROXY_API_KEY=
AGENT_MODEL=litellm_proxy/openai/gpt-4.1-mini
AGENT_TEMPERATURE=0.2

# Optional SQLAlchemy warehouse connection.
# Leave blank to use Goodwill Michiana demo rows.
WAREHOUSE_DSN=

# Microsoft Graph / Teams
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=

# Copilot Studio handoff webhook or topic trigger endpoint
COPILOT_STUDIO_WEBHOOK_URL=
COPILOT_STUDIO_API_KEY=

# Power BI screenshot capture.
# POWERBI_IMAGE_EXPORT_URL should return a PNG/JPEG if you already have an export endpoint.
# POWERBI_REPORT_WEB_URL uses Playwright to capture a report/embed page.
POWERBI_IMAGE_EXPORT_URL=
POWERBI_REPORT_WEB_URL=
POWERBI_BEARER_TOKEN=
POWERBI_REPORT_NAME=Goodwill Michiana Operations Dashboard

# Optional MCP stdio server for hackathon extensions
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=[]
MCP_SERVER_ENV={}
